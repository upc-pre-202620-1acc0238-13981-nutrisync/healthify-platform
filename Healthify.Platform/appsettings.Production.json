{
  "ConnectionStrings": {
    "DefaultConnection": "server=%DATABASE_HOST%;port=3306;user=%DATABASE_USER%;password=%DATABASE_PASSWORD%;database=%DATABASE_SCHEMA%"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "%FRONTEND_ORIGIN%"
    ]
  },
  "TokenSettings": {
    "Secret": "%JWT_SECRET%",
    "RefreshTokenDays": 30,
    "RefreshReuseGraceSeconds": 30
  },
  "Usda": {
    "ApiKey": "%USDA_API_KEY%"
  },
  "Seeder": {
    "Enabled": false
  },
  "Iam": {
    "LockoutMinutes": 15
  },
  "Intake": {
    "SelfWeighInProtocol": [
      "Fasted"
    ]
  },
  "Monitoring": {
    "EscalationDaysAfterPatientAcknowledgement": 7
  },
  "MonitoringAdherence": {
    "ClinicalTimeZone": "America/Lima"
  },
  "NutritionalCare": {
    "ClinicalTimeZone": "America/Lima",
    "ActivityFactors": {
      "Sedentary": 1.2,
      "Light": 1.375,
      "Moderate": 1.55,
      "Intense": 1.725
    },
    "DefaultTargetParameters": {
      "Equation": "MifflinStJeor",
      "ReferenceWeightKind": "Actual",
      "DeficitKind": "FixedKcal",
      "DeficitValue": 500,
      "ProteinGramsPerKg": 1.6,
      "FatPercentOfEnergy": 30
    },
    "CalorieFloorKcal": {
      "Female": 1200,
      "Male": 1500
    },
    "PlanProposalRecoveryHours": 72
  },
  "Scheduling": {
    "AiGenerationPurgeIntervalMinutes": 360,
    "ReviewItemRecheckIntervalHours": 12,
    "PlanProposalRecoveryIntervalMinutes": 30
  },
  "Ai": {
    "Enabled": false,
    "Provider": "Gemini",
    "Model": "gemini-3.5-flash",
    "Gemini": {
      "Mode": "GeminiApi",
      "ProjectId": "",
      "Location": "global"
    },
    "TimeoutSeconds": 20,
    "RetentionDays": 180,
    "Features": {
      "WeeklySummary": {
        "Enabled": true,
        "DailyLimit": 20,
        "MaxOutputTokens": 2048,
        "Cron": "0 6 * * 1"
      },
      "MealIdeas": {
        "Enabled": true,
        "DailyLimit": 10,
        "MaxOutputTokens": 2048
      },
      "SuggestedQuestions": {
        "Enabled": true,
        "DailyLimit": 20,
        "MaxOutputTokens": 2048
      },
      "PractitionerMonitoringSummary": {
        "Enabled": true,
        "DailyLimit": 100,
        "MaxOutputTokens": 2048
      },
      "DiagnosisSuggestion": {
        "Enabled": true,
        "DailyLimit": 100,
        "MaxOutputTokens": 2048
      },
      "GuidelineSuggestions": {
        "Enabled": true,
        "DailyLimit": 100,
        "MaxOutputTokens": 2048
      },
      "PlanAdjustmentProposal": {
        "Enabled": true,
        "DailyLimit": 100,
        "MaxOutputTokens": 2048
      }
    }
  }
}
